# ============ FRONTEND CONFIGURATION ============
REACT_APP_BACKEND_URL=http://localhost:8001

# ============ BACKEND DATABASE ============
MONGO_URL=mongodb://localhost:27017
DB_NAME=congo_auto_db

# ============ MTN MOBILE MONEY API ============
MTN_API_USER_ID=your_mtn_api_user_id
MTN_API_KEY=your_mtn_api_key
MTN_SUBSCRIPTION_KEY=your_mtn_subscription_key
MTN_TARGET_ENVIRONMENT=sandbox
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_CALLBACK_HOST=http://localhost:8001

# ============ APPLICATION FEES (in XAF) ============
REGISTRATION_FEE_SALE_XAF=3000
REGISTRATION_FEE_RENTAL_XAF=1500
POSTING_FEE_SALE_XAF=3000
POSTING_FEE_RENTAL_XAF=1500

# ============ MERCHANT INFORMATION ============
MERCHANT_PHONE=242068913333
MERCHANT_CODE=374575

# ============ SECURITY ============
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============ CORS ============
# Production: https://yourdomain.com,https://www.yourdomain.com
# Development: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ============ NODE ENVIRONMENT ============
NODE_ENV=development